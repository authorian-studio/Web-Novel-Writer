{
  "name": "novelist-web",
  "private": true,
  "description": "Novelist — aplikasi web menulis novel. Situsnya statis (tanpa build); package.json ini hanya untuk membangun ulang file di vendor/.",
  "scripts": {
    "build": "npm run build:vendor && npm run build:css",
    "build:vendor": "node tools/build-vendor.mjs",
    "build:css": "tailwindcss -i tailwind.input.css -o vendor/tailwind.css --minify"
  },
  "devDependencies": {
    "@base-ui/react": "1.8.0",
    "@tailwindcss/cli": "4.3.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "esbuild": "0.24.2",
    "lucide-react": "1.48.0",
    "radix-ui": "1.6.7",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0"
  }
}
